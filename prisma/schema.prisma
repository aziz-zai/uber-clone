// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider  = "postgresql"
    // App-Queries über den Supabase Transaction Pooler (6543, serverless-tauglich)
    url       = env("DATABASE_URL")
    // Migrationen brauchen eine direkte Verbindung (5432)
    directUrl = env("DIRECT_URL")
}

// --- Domänenmodell (siehe CONTEXT.md) ---
// Jede mandantenbezogene Tabelle trägt operatorId (ADR 0001).

model Operator {
    id        String   @id @default(cuid())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    vehicles Vehicle[]
    drivers  Driver[]
}

enum VehicleStatus {
    ACTIVE
    MAINTENANCE
    INACTIVE
}

enum VehicleClass {
    STANDARD
    VAN
    PREMIUM
}

enum DriverStatus {
    OFFLINE
    ONLINE
    BUSY
}

enum LicenseClass {
    B
    BE
    C
    CE
}

model Driver {
    id            String       @id @default(cuid())
    operatorId    String
    operator      Operator     @relation(fields: [operatorId], references: [id])
    name          String
    licenseNumber String
    licenseClass  LicenseClass
    status        DriverStatus @default(OFFLINE)
    vehicleId     String?      @unique
    vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id])
    createdAt     DateTime     @default(now())
    updatedAt     DateTime     @updatedAt

    @@unique([operatorId, licenseNumber])
    @@index([operatorId, status])
}

model Vehicle {
    id           String        @id @default(cuid())
    operatorId   String
    operator     Operator      @relation(fields: [operatorId], references: [id])
    licensePlate String
    vehicleClass VehicleClass  @default(STANDARD)
    seats        Int
    status       VehicleStatus @default(ACTIVE)
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt

    driver       Driver?

    @@unique([operatorId, licensePlate])
    @@index([operatorId, status])
}
