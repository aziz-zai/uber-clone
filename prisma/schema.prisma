// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // App-Queries über den Supabase Transaction Pooler (6543, serverless-tauglich)
  url       = env("DATABASE_URL")
  // Migrationen brauchen eine direkte Verbindung (5432)
  directUrl = env("DIRECT_URL")
}

// --- Domänenmodell (siehe CONTEXT.md) ---
// Jede mandantenbezogene Tabelle trägt operatorId (ADR 0001).

model Operator {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
  drivers  Driver[]
  orders   Order[]
  rides    Ride[]
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum VehicleClass {
  STANDARD
  VAN
  PREMIUM
}

enum DriverStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum LicenseClass {
  B
  BE
  C
  CE
}

model Driver {
  id                       String       @id @default(cuid())
  operatorId               String
  operator                 Operator     @relation(fields: [operatorId], references: [id])
  name                     String
  licenseNumber            String
  licenseClass             LicenseClass
  status                   DriverStatus @default(OFFLINE)
  vehicleId                String?      @unique
  vehicle                  Vehicle?     @relation(fields: [vehicleId], references: [id])
  // Aktuelle Position — manueller Platzhalter, bis eine Driver-App echte
  // GPS-Daten liefert (siehe ADR 0003). currentLocationGeo (PostGIS) wird
  // per Hand-SQL in der Migration daraus generiert.
  currentLat               Float?
  currentLng               Float?
  currentLocationUpdatedAt DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  rides Ride[]

  @@unique([operatorId, licenseNumber])
  @@index([operatorId, status])
}

model Vehicle {
  id           String        @id @default(cuid())
  operatorId   String
  operator     Operator      @relation(fields: [operatorId], references: [id])
  licensePlate String
  vehicleClass VehicleClass  @default(STANDARD)
  seats        Int
  status       VehicleStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  driver Driver?

  @@unique([operatorId, licensePlate])
  @@index([operatorId, status])
}

enum RideStatus {
  REQUESTED
  ASSIGNED
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  PAID
  CANCELLED
}

enum CancelledByRole {
  RIDER
  DRIVER
  OPERATOR
}

// Rider ist plattformweit, ohne operatorId (ADR 0001) — Endkunden können
// potenziell bei mehreren Operatoren buchen.
model Rider {
  id               String   @id @default(cuid())
  name             String
  phone            String   @unique
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders Order[]
}

model Order {
  id                 String        @id @default(cuid())
  operatorId         String
  operator           Operator      @relation(fields: [operatorId], references: [id])
  riderId            String
  rider              Rider         @relation(fields: [riderId], references: [id])
  originAddress      String
  originLat          Float
  originLng          Float
  destinationAddress String
  destinationLat     Float
  destinationLng     Float
  vehicleClass       VehicleClass?
  createdAt          DateTime      @default(now())

  ride Ride?

  @@index([operatorId, createdAt])
}

model Ride {
  id                      String           @id @default(cuid())
  operatorId              String
  operator                Operator         @relation(fields: [operatorId], references: [id])
  orderId                 String           @unique
  order                   Order            @relation(fields: [orderId], references: [id])
  driverId                String?
  driver                  Driver?          @relation(fields: [driverId], references: [id])
  status                  RideStatus       @default(REQUESTED)
  cancelReason            String?
  cancelledByRole         CancelledByRole?
  assignedAt              DateTime?
  acceptedAt              DateTime?
  arrivedAt               DateTime?
  inProgressAt            DateTime?
  completedAt             DateTime?
  paidAt                  DateTime?
  priceInCents            Int?
  currency                String           @default("eur")
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([operatorId, status])
}
